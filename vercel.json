{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/opruimen",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/onboarding",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/klantenbord",
      "schedule": "0 6 * * 1-5"
    },
    {
      "path": "/api/cron/weekevaluatie",
      "schedule": "0 13 * * 5"
    }
  ]
}
